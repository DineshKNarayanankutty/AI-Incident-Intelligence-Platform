# Local defaults — never store credentials here.
APP_ENV=local
INFERENCE_BACKEND=local
FOUNDRY_BACKEND=local
MODEL_PATH=outputs/model/model.joblib
DRIFT_BASELINE_PATH=outputs/model/drift_baseline.json
MLFLOW_TRACKING_URI=sqlite:///outputs/mlflow/mlflow.db
MLFLOW_EXPERIMENT_NAME=incident-severity-local

# Azure ML: set only when using INFERENCE_BACKEND=azureml
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_ML_WORKSPACE=
AZURE_ML_ENDPOINT_NAME=incident-severity-endpoint
AZURE_ML_DEPLOYMENT_NAME=blue
AZURE_ML_MODEL_NAME=incident-severity
AZURE_ML_MODEL_VERSION=1
AZURE_ML_SCORING_URI=

# Microsoft Foundry: set only when using FOUNDRY_BACKEND=azure
AZURE_AI_PROJECT_ENDPOINT=
FOUNDRY_AGENT_NAME=
FOUNDRY_AGENT_VERSION=
AZURE_AI_MODEL_DEPLOYMENT_NAME=

# Observability
APPLICATIONINSIGHTS_CONNECTION_STRING=
OTEL_SERVICE_NAME=ai-incident-intelligence-api

# App Service deployment metadata (used by CI/CD; not credentials)
AZURE_API_APP_NAME=aiincident-api
AZURE_APP_INSIGHTS_NAME=aiincident-appi
